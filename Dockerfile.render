# Small container for Render (free plan: 512 MB RAM). No Ollama: embeddings come from a small ONNX
# model in the app process (fastembed, bge-small-en-v1.5), answers and agents from Gemini.
# The document index is built here and needs no key; GEMINI_API_KEY is only read at run time.
FROM python:3.13-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    CHAT_PROVIDER=gemini \
    EMBED_PROVIDER=fastembed \
    FASTEMBED_CACHE_PATH=/home/user/fastembed-cache \
    DEMO_MODE=1
WORKDIR /home/user/app

COPY --chown=user requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

COPY --chown=user . .

# Build the document index: download the PDF and the embedding model, run ingest.py.
ARG DOC_URL=https://docs.aws.amazon.com/pdfs/wellarchitected/latest/framework/wellarchitected-framework.pdf
ARG MAX_PAGES=200
RUN mkdir -p data \
 && curl -fsSL -o data/wellarchitected-framework.pdf "$DOC_URL" \
 && python ingest.py data/ --max-pages "$MAX_PAGES" \
 && rm -rf data

CMD ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000}"]
